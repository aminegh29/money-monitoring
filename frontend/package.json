{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:lan": "ng serve --host 0.0.0.0",
    "mobile:build": "ng build && npx cap sync",
    "android": "ng build && npx cap sync android && npx cap open android",
    "ios": "ng build && npx cap sync ios && npx cap open ios",
    "mobile:assets": "npx capacitor-assets generate --iconBackgroundColor \"#04050d\" --iconBackgroundColorDark \"#04050d\" --splashBackgroundColor \"#04050d\" --splashBackgroundColorDark \"#04050d\""
  },
  "private": true,
  "dependencies": {

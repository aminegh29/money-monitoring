# Copy this file to .env on the server and fill in the values (copy them from Render → Environment).
# .env is ignored by git: never commit it, never paste it anywhere.

# Address of the backend, without https:// (e.g. moneymonitor-api.duckdns.org)
API_DOMAIN=

SPRING_PROFILES_ACTIVE=postgres
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Keep the same value as on Render so signed-in users stay signed in.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Address of the website (Netlify or your domain), no / at the end
APP_FRONTEND_URL=

BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Money Monitor

AI_PROVIDER=groq
AI_API_KEY=

# The free Oracle server has 12 GB of RAM: give Java more room than on Render.
JAVA_OPTS=-Xmx1g -XX:+UseG1GC -XX:MaxMetaspaceSize=192m
